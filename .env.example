# Copy to .env and fill in:   cp .env.example .env
# .env is git-ignored. Never commit real secrets.

# ---- Core ----
# True for local development only. False turns on HTTPS redirects and secure cookies.
DJANGO_DEBUG=True
# Required when DJANGO_DEBUG=False. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database ----
# Option A - SQLite (local development / exploring the API only):
DB_ENGINE=django.db.backends.sqlite3
# Option B - PostgreSQL (required for production and realistic payroll runs):
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=uipayroll
# DB_USER=uipayroll
# DB_PASSWORD=change-me        # required when DJANGO_DEBUG=False
# DB_HOST=127.0.0.1
# DB_PORT=5432

# ---- Celery / Redis ----
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
# True = run tasks inline (no Redis/worker needed). Must be False in production.
CELERY_EAGER=True

# ---- Email ----
# While DJANGO_DEBUG=True, emails are printed to the terminal (console backend).
# Fill these in for real SMTP delivery (DJANGO_DEBUG=False).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=payroll@localhost

# ---- Payroll ----
# Email staff a "payslip ready" notice (no amounts) after each batch.
PAYROLL_NOTIFY_STAFF=True
